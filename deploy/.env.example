# Copy to deploy/.env and change every password. deploy/.env is git-ignored; never commit it.

# Public host name. "localhost" uses Caddy's internal CA (trust its root or accept the browser warning).
STANDPOS_DOMAIN=localhost

# prod, or demo for the Oracle demo VM (same settings, sandbox-only data).
STANDPOS_PROFILE=prod

# PostgreSQL superuser (used only by the database container and the backup job).
POSTGRES_PASSWORD=change-me-postgres
# Schema owner: runs Flyway migrations at backend start.
STANDPOS_DB_OWNER_PASSWORD=change-me-owner
# Runtime role: subject to Row-Level Security.
STANDPOS_DB_APP_PASSWORD=change-me-app

# First tenant, venue and owner, created by:
#   docker compose -f deploy/docker-compose.yml run --rm backend --bootstrap
# The command does nothing if the owner email already exists.
STANDPOS_BOOTSTRAP_TENANT_NAME=Oratorio San Luigi
STANDPOS_BOOTSTRAP_VENUE_NAME=Bar oratorio
STANDPOS_BOOTSTRAP_OWNER_NAME=Titolare
STANDPOS_BOOTSTRAP_OWNER_EMAIL=owner@example.org
# At least 10 characters.
STANDPOS_BOOTSTRAP_OWNER_PASSWORD=change-me-owner-login
# Optional 4-6 digit PIN, so the owner can also log in on a register.
STANDPOS_BOOTSTRAP_OWNER_PIN=

# Nightly backups (UTC time, number of dumps kept, host directory).
STANDPOS_BACKUP_AT=02:30
STANDPOS_BACKUP_KEEP=30
STANDPOS_BACKUP_DIR=./backups
