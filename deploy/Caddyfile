# StandPOS edge: automatic TLS, the PWA as static files, and the API behind it.
# STANDPOS_DOMAIN=localhost uses Caddy's internal CA; a real domain gets a Let's Encrypt certificate.
{$STANDPOS_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@backend path /api/* /ws /ws/* /webhooks/* /actuator/health /actuator/health/*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv

		# Fingerprinted assets never change; the shell and service worker must always be revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
